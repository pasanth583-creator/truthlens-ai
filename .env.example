# TruthLens AI Environment Variables Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secure-random-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///database/truthlens.db

# Model & Explainability Configuration
MODEL_PATH=models/production
EXPLANATION_CONFIDENCE_THRESHOLD=0.60
MIN_INPUT_LENGTH=5
MAX_INPUT_LENGTH=10000

